flowchart TD
    customer["ลูกค้า: ?table=1<br/>ไม่สมัครสมาชิก"]
    employee["พนักงาน / ผู้จัดการ"]

    subgraph customerPages["หน้าลูกค้า: ขาว/น้ำเงิน · หัวหน้าเฉพาะโต๊ะ N"]
        menu["index.php<br/>เมนู · หมวดอาหาร · ปุ่ม − / +"]
        cart["cart.php<br/>ตรวจจำนวน · หมายเหตุถ้ามี · ยืนยันส่ง"]
        orders["orders.php<br/>รายการที่สั่ง · สถานะ · บริการ / ขอบิล"]
