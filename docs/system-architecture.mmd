        cart <-->|"แถบนำทางร่วม"| orders
        orders --> menu
    end
    customer --> menu

    menu -->|"POST จำนวน ผ่าน XMLHttpRequest"| customerAction["actions/customer.php<br/>ตรวจ token และรอบเดิม<br/>เก็บร่าง / สั่ง / เรียกพนักงาน / ขอบิล"]
    cart -->|"POST จำนวนหรือหมายเหตุ / ยืนยันสั่ง"| customerAction
    orders -->|"POST เรียกพนักงานหรือขอบิล"| customerAction
    customerAction <-->|"ยังไม่ใช่ออร์เดอร์ในฐานข้อมูล"| draft[("PHP session: ตะกร้าแยกตาม visit ID<br/>เปลี่ยนหน้า รีเฟรช เรียกพนักงานแล้วร่างยังอยู่<br/>คนละเบราว์เซอร์แยกตะกร้า")]
    draft --> cart
    customerAction -->|"สำเร็จ: HTML fragment หรือ redirect ตามงาน"| customerPages

    employee --> login["login.php<br/>password_verify + ตรวจบัญชีเปิดใช้งาน"]
    login --> employeeSession["PHP session: employee ID<br/>session-ID cookie ในเบราว์เซอร์"]
    employeeSession --> auth["includes/auth.php<br/>ตรวจสิทธิ์ทุกคำขอพนักงาน"]
    auth --> staffPages["staff/*.php<br/>โต๊ะ · ออร์เดอร์ · บิล<br/>เมนู · บัญชี · รายงาน"]
    staffPages -->|"POST + token<br/>เปิดโต๊ะเร็วผ่าน XMLHttpRequest"| staffActions["actions/table.php · order.php<br/>menu.php · employee.php"]
    staffActions -->|"HTML update หรือ redirect<br/>เก็บข้อมูลเมื่อกรอกผิด"| staffPages

    orders <-->|"XMLHttpRequest / HTML สถานะ"| customerAjax["ajax/customer-status.php<br/>ผูกประวัติกับรอบเดิม แม้จบรอบแล้ว"]
    staffPages <-->|"XMLHttpRequest / HTML<br/>ไม่ทับช่องหรือปุ่มที่กำลังใช้งาน"| staffAjax["ajax/staff-status.php"]

    customerAction --> guards["ตรวจรอบและข้อมูล<br/>ราคาเปลี่ยน: ให้ตรวจใหม่<br/>ขอบิลแล้ว: หยุดสั่ง แต่พนักงานยกเลิกคำขอได้"]
    staffActions --> guards
    guards --> payment["ธุรกรรมเขียน: ล็อกโต๊ะ / transaction<br/>ปิดบิล: ไม่มีออร์เดอร์ค้าง<br/>ยอดต้องตรงกับที่ตรวจไว้ มิฉะนั้นกลับไปตรวจใหม่"]
    payment --> connection["connection.php<br/>PDO + prepared statements"]
    login --> connection
    customerAjax --> connection
    staffAjax --> connection
    menu -->|"อ่านเมนู"| connection
    cart -->|"อ่านอาหารและราคา"| connection
    staffPages -->|"อ่านข้อมูล"| connection
    connection --> db[("MariaDB: fedfebuffet<br/>TABLE · SESSION · ORDER<br/>ITEM · MENU · EMPLOYEE<br/>คง schema และข้อมูลเดิม")]
    db -.-> unused["MEMBER / SESSION_MEMBER<br/>ยังไม่ใช้"]

    assets["CSS ขาว/น้ำเงิน · JavaScript ปกติ<br/>ภาพอาหารหรือ placeholder · ไม่มี JSON / framework"] --> customerPages
